# Shared PIN that gates the whole site. Everyone in the family types this once.
FAMILY_PIN=1234

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Local development: a plain SQLite file, no service to sign up for.
# On Vercel set this to your Turso URL (libsql://<name>.turso.io) and add
# DATABASE_AUTH_TOKEN — Vercel's filesystem is wiped on every deploy, so a
# file-backed database there would lose everyone's picks.
DATABASE_URL=file:./data/picks.db
# DATABASE_AUTH_TOKEN=

# Season the app defaults to.
NFL_SEASON=2026
